      }
    },
    "stop_air_purge": {
      "name": "Stop air purge",
      "description": "Cancels a running air purge.",
      "fields": {
        "entry_id": { "name": "Board", "description": "Board to act on." }
      }
    },
    "run_anti_seize": {
      "name": "Run anti-seize routine",
      "description": "Cycles every relay so actuators do not seize.",
      "fields": {
        "entry_id": { "name": "Board", "description": "Board to act on." },
        "duration": { "name": "Duration", "description": "Cycle duration in seconds." }
      }
    },
    "reset_metrics": {
      "name": "Reset metrics",
      "description": "Clears runtime and cycle counters.",
      "fields": {
        "entry_id": { "name": "Board", "description": "Board to act on." }
      }
    },
    "emergency_stop": {
      "name": "Emergency stop",
      "description": "Closes every valve and stops the circulator immediately, ignoring the minimum cycle timers.",
      "fields": {
        "entry_id": { "name": "Board", "description": "Board to act on." }
      }
    }
  }
