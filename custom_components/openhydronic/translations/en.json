          "host": "Host / IP",
          "device_name": "Board name",
          "port": "Native API port"
        }
      },
      "discovery_confirm": {
        "title": "OpenHydronic board found",
        "description": "Do you want to add {name} ({host})? You will map the relays to zones in the next step."
      }
    },
    "abort": {
      "already_configured": "This board is already configured."
