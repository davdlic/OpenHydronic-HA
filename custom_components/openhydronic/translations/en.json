          "remove_zone": "Remove zones",
          "master": "Master manager (circulator / boiler)",
          "timings": "Regulation and cycle timings",
          "protections": "Protections and routines"
        }
      },
      "add_zone": {
        "title": "Add zone",
        "description": "Bind a relay to a temperature sensor. A bypass zone needs no sensor.",
        "data": {
          "name": "Zone name",
          "relay_entity": "Relay / actuator",
          "sensor_entity": "Temperature sensor",
          "comfort_temp": "Comfort setpoint",
          "eco_temp": "Eco setpoint",
          "away_temp": "Away setpoint",
          "is_bypass": "This is the bypass loop"
        }
      },
