          "comfort_temp": "Comfort setpoint",
          "eco_temp": "Eco setpoint",
          "away_temp": "Away setpoint",
          "is_bypass": "This is the bypass loop"
        }
      },
      "remove_zone": {
        "title": "Remove zones",
